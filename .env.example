# App
NODE_ENV=development
PORT=4010
BASE_URL=http://localhost:4010
NEXTAUTH_URL=http://localhost:4010
AUTH_SECRET=dev-only-change-me
AUTH_TRUST_HOST=1

# OAuth Providers (optional)
# Google OAuth - Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft/Azure AD OAuth - Get credentials from https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Database
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://localhost:5432/lunas
SQLITE_PATH=.data/lunas.db
SQLITE_SEARCH_ROOTS=
SRC_SQLITE=

# Seed users
DEV_EMAILS=admin@lunas.local
DEV_PASSWORD=dev

# Real-time
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_KEY=

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=

# File storage
UPLOADTHING_SECRET=
STORAGE_DRIVER=uploadthing

# Billing / invoicing
TAX_RATE=0.000

# Automation / ingest
CRON_SECRET=
INGEST_URL=http://localhost:4010/api/ingest/pulte
INGEST_TOKEN=

# Pulte harvester scripts
PULTE_BASE_URL=https://bwp.pulte.com
PULTE_USER=
PULTE_PASS=
PULTE_USERNAME=
PULTE_PASSWORD=
HARVEST_DEBUG=false
HEADLESS=true
START_DATE=
END_DATE=
