# App
NODE_ENV=development
PORT=4010
BASE_URL=http://localhost:4010
NEXTAUTH_URL=http://localhost:4010
AUTH_SECRET=dev-only-change-me
AUTH_TRUST_HOST=1

# Convex
NEXT_PUBLIC_CONVEX_URL=         # From: npx convex dev (or Convex dashboard)
CONVEX_DEPLOY_KEY=              # Production deploy key (Vercel only)

# AI — Chat widget + document extraction (at least one required)
OPENROUTER_API_KEY=             # Primary — GPT-5 Nano via OpenRouter ($0.05/M)
GOOGLE_GENERATIVE_AI_API_KEY=   # Fallback — Gemini 2.5 Flash Lite (1K free pages/mo)
OPENAI_API_KEY=                 # Fallback — direct OpenAI GPT-4o-mini

# GitHub — Agentic code editing (admin chat can edit repo + push to main)
GITHUB_TOKEN=                   # PAT with repo scope — github.com/settings/tokens

# Seed users
DEV_EMAILS=admin@lunas.local
DEV_PASSWORD=dev

# Telegram bot — LUNAS AI via Telegram channel
TELEGRAM_BOT_TOKEN=             # From @BotFather on Telegram
TELEGRAM_WEBHOOK_SECRET=        # Random string for webhook registration auth

# Messaging (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
RESEND_BASE_URL=                # Optional — set to your FreeResend instance URL (e.g. https://mail.yourdomain.com/api)
RESEND_FROM_EMAIL=              # Optional — sender address (default: LUNAS AI <notifications@lunas.construction>)

# File storage (optional)
UPLOADTHING_SECRET=
STORAGE_DRIVER=uploadthing

# Billing / invoicing
TAX_RATE=0.000

# Pulte harvester scripts (optional)
PULTE_BASE_URL=https://bwp.pulte.com
PULTE_USER=
PULTE_PASS=
HARVEST_DEBUG=false
HEADLESS=true
