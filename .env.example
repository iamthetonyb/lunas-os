# ======================================
# LUNAS-OS Environment Configuration
# ======================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ======================================
# DATABASE
# ======================================
DATABASE_URL=postgresql://user:password@localhost:5432/lunas_db

# ======================================
# AUTHENTICATION
# ======================================
NEXTAUTH_URL=http://localhost:4010
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production

# Development Default User (optional - defaults provided in seed script)
# ⚠️ FOR DEVELOPMENT ONLY - Change in production!
DEFAULT_USER_EMAIL=dispatcher@lunas.com
DEFAULT_USER_PASSWORD=password

# ======================================
# EMAIL SERVICE (Resend)
# ======================================
RESEND_API_KEY=

# ======================================
# SMS SERVICE (Twilio)
# ======================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ======================================
# FILE STORAGE
# ======================================
# Options: 'uploadthing' or 's3'
STORAGE_DRIVER=uploadthing

# UploadThing (if STORAGE_DRIVER=uploadthing)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# S3 (if STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ======================================
# COMPANY SETTINGS
# ======================================
TAX_RATE=0.00
COMPANY_NAME=Lunas
COMPANY_EMAIL=
COMPANY_ADDRESS=

# ======================================
# DEVELOPMENT SETTINGS
# ======================================
# Port for development server (default: 4010)
PORT=4010

# Node environment (auto-set by scripts, but can override)
# NODE_ENV=development

