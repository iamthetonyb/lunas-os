{
  "name": "lunas-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=development PORT=4010 next dev -p 4010",
    "dev:safe": "./dev-start.sh",
    "dev:keepalive": "./keep-server-alive.sh",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=development PORT=4010 next dev -p 4010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "db:seed": "node dist/scripts/seed.js",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm build:scripts && pnpm db:seed",
    "db:reset": "tsx scripts/reset-db.ts && pnpm db:setup",
    "test:unit": "vitest",
    "pretest:e2e": "npx puppeteer browsers install chromium@1083080 || true",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:devtools": "node scripts/e2e-with-devtools.mjs",
    "test:e2e:comprehensive": "node scripts/e2e-with-devtools.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.3.1",
    "@uploadthing/react": "^7.3.3",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.44.6",
    "i18next": "^25.6.0",
    "i18next-resources-to-backend": "^1.2.1",
    "next": "15.5.5",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.9",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.0.1",
    "react-signature-canvas": "1.1.0-alpha.2",
    "resend": "^6.1.2",
    "swr": "^2.3.6",
    "twilio": "^5.10.2",
    "uploadthing": "^7.7.4",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-signature-canvas": "^1.0.7",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "^15.5.5",
    "jest": "^30.2.0",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "puppeteer": "^24.24.1",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "puppeteer": {
    "browser": "chromium",
    "revision": "1083080"
  }
}