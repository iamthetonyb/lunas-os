{
  "name": "lunas-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "PORT=${PORT:-4010} next dev -p ${PORT:-4010}",
    "dev:safe": "./dev-start.sh",
    "dev:keepalive": "./scripts/dev/keep-server-alive.sh",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=development PORT=4010 next dev --webpack -p 4010",
    "prebuild": "pnpm remove better-sqlite3 @libsql/client libsql @types/better-sqlite3 2>/dev/null || true",
    "build": "next build",
    "start": "PORT=${PORT:-4010} next start -p ${PORT:-4010}",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:migrate:sqlite": "tsx scripts/migrate-sqlite.ts",
    "db:seed:sqlite": "tsx scripts/seed.ts",
    "db:sqlite": "pnpm db:generate:sqlite && pnpm db:migrate:sqlite && pnpm db:seed:sqlite",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:migrate:pg": "node scripts/migrate-pg.cjs",
    "db:seed:pg": "tsx scripts/seed.ts",
    "db:seed:min": "tsx scripts/seed-min.ts",
    "db:seed:services": "pnpm tsx scripts/seed-services.ts",
    "db:find:sqlite": "pnpm tsx scripts/find-sqlite.ts --roots=$PWD --minSizeMB=0.05",
    "db:find:sqlite:home": "pnpm tsx scripts/find-sqlite.ts --roots=$HOME --minSizeMB=0.05",
    "db:find:sqlite:all": "pnpm tsx scripts/find-sqlite.ts --roots=$HOME,/Volumes --minSizeMB=0.05",
    "db:copy:sqlite": "pnpm tsx scripts/copy-sqlite-to-pg.ts",
    "db:find:pulte": "pnpm tsx scripts/find-pulte-files.ts --roots=$PWD,$HOME,/Volumes --minSizeKB=10",
    "db:ingest:pulte": "pnpm tsx scripts/ingest-pulte.ts",
    "db:seed:crews": "pnpm tsx scripts/seed-crews.ts",
    "git:find:db": "tsx scripts/git-find-db.ts",
    "db:pg": "pnpm db:generate:pg && pnpm db:migrate:pg && pnpm db:seed:pg",
    "db:setup": "node -e \"process.env.DATABASE_PROVIDER==='postgres'||process.env.DATABASE_URL?process.exit(0):process.exit(1)\" && pnpm db:pg || pnpm db:sqlite",
    "db:reset": "tsx scripts/reset-db.ts && pnpm db:setup",
    "test": "vitest",
    "test:unit": "vitest",
    "pretest:e2e": "npx puppeteer browsers install chromium || true",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:devtools": "node scripts/e2e-with-devtools.mjs",
    "test:e2e:comprehensive": "node scripts/e2e-with-devtools.mjs",
    "harvest:pulte": "pnpm tsx --env-file=.env.harvester scripts/harvest-pulte.ts",
    "harvest:pulte:excel": "pnpm tsx --env-file=.env.harvester scripts/harvest-pulte-excel.ts",
    "harvest:pulte:old": "tsx --env-file=.env.harvester workers/pulte-harvester/pulte.scrape.ts",
    "harvest:pulte:bootstrap": "HEADLESS=false tsx --env-file=.env.harvester workers/pulte-harvester/pulte.scrape.ts",
    "ingest:pulte:live": "pnpm tsx --env-file=.env.harvester scripts/ingest-pulte-live.ts"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@auth/drizzle-adapter": "^1.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@keyv/etcd": "^2.1.1",
    "@keyv/mongo": "^3.0.5",
    "@keyv/mysql": "^2.1.7",
    "@keyv/offline": "^4.0.2",
    "@keyv/postgres": "^2.2.0",
    "@keyv/redis": "^5.1.4",
    "@keyv/sqlite": "^4.0.6",
    "@keyv/tiered": "^2.0.2",
    "@react-email/render": "^2.0.0",
    "@react-pdf/renderer": "^4.3.1",
    "@uploadthing/react": "^7.3.3",
    "ably": "^1.2.50",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.6",
    "fast-glob": "^3.3.2",
    "i18next": "^25.6.0",
    "i18next-resources-to-backend": "^1.2.1",
    "keyv": "4.5.4",
    "next-auth": "5.0.0-beta.30",
    "nodemailer": "^6.9.11",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.0.1",
    "react-signature-canvas": "1.1.0-alpha.2",
    "resend": "^6.1.2",
    "server-only": "^0.0.1",
    "swr": "^2.3.6",
    "twilio": "^5.10.2",
    "uploadthing": "^7.7.4",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/react-signature-canvas": "^1.0.7",
    "@types/yargs": "^17.0.34",
    "autoprefixer": "^10.4.21",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "^16.0.3",
    "jest": "^30.2.0",
    "next": "16.0.3",
    "playwright": "^1.56.1",
    "postcss": "8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "puppeteer": "22.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1",
    "yargs": "^18.0.0"
  },
  "puppeteer": {
    "browser": "chromium",
    "revision": "1083080"
  },
  "engines": {
    "node": ">=20.12.0 <21"
  }
}
