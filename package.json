{
  "name": "lunas-os",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "PORT=${PORT:-4010} next dev -p ${PORT:-4010}",
    "dev:safe": "./dev-start.sh",
    "dev:keepalive": "./scripts/dev/keep-server-alive.sh",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=development PORT=4010 next dev --webpack -p 4010",
    "build": "next build",
    "build:convex": "npx convex deploy --cmd 'next build'",
    "build:next": "next build",
    "start": "PORT=${PORT:-4010} next start -p ${PORT:-4010}",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "convex:dev": "npx convex dev",
    "convex:seed": "pnpm tsx scripts/seed-convex-from-backup.ts",
    "test": "vitest",
    "test:unit": "vitest",
    "pretest:e2e": "npx puppeteer browsers install chromium || true",
    "test:e2e": "node scripts/e2e-run.mjs",
    "test:e2e:devtools": "node scripts/e2e-with-devtools.mjs",
    "test:e2e:comprehensive": "node scripts/e2e-with-devtools.mjs",
    "harvest:pulte": "pnpm tsx --env-file=.env.harvester scripts/harvest-pulte.ts",
    "harvest:pulte:excel": "pnpm tsx --env-file=.env.harvester scripts/harvest-pulte-excel.ts",
    "ingest:pulte:live": "pnpm tsx --env-file=.env.harvester scripts/ingest-pulte-live.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/react": "^3.0.118",
    "@auth/core": "^0.34.3",
    "@clerk/nextjs": "^7.0.6",
    "@convex-dev/rag": "^0.7.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@octokit/rest": "^22.0.1",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@react-email/render": "^2.0.0",
    "@react-pdf/renderer": "^4.3.1",
    "@uploadthing/react": "^7.3.3",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "convex": "^1.34.0",
    "fast-glob": "^3.3.2",
    "grammy": "^1.41.1",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "i18next-resources-to-backend": "^1.2.1",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.9.11",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.0.1",
    "react-signature-canvas": "1.1.0-alpha.2",
    "resend": "^6.1.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "twilio": "^5.10.2",
    "uploadthing": "^7.7.4",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/react-signature-canvas": "^1.0.7",
    "@types/yargs": "^17.0.34",
    "autoprefixer": "^10.4.21",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.3",
    "jest": "^30.2.0",
    "next": "16.2.0",
    "playwright": "^1.56.1",
    "postcss": "8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "puppeteer": "22.15.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1",
    "yargs": "^18.0.0"
  },
  "puppeteer": {
    "browser": "chromium",
    "revision": "1083080"
  },
  "engines": {
    "node": "20.x"
  }
}
