# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore legacy status files in the root directory.
# All historical logs should be in /docs/sessions/
/*-STATUS.txt
/*-FIXED.txt
/*-WORKING.txt
/*-READY.txt
SESSION-*.md

# SQLite dev database
*.db
*.db-shm
*.db-wal
dev.db*

# logs / runtime artifacts
logs/

# Screenshots
*.png
*.jpg
*.jpeg

# Harvester session artifacts
workers/pulte-harvester/pulte-state.json
workers/pulte-harvester/NEEDS_LOGIN
workers/pulte-harvester/pulte-debug.html
workers/pulte-harvester/pulte-debug.png
workers/pulte-harvester/outbox/
workers/pulte-harvester/jobs-debug.html

# clerk configuration (can include secrets)
/.clerk/
